# Configurações do Banco de Dados PostgreSQL (pgvector)
# Observação: A porta padrão no host é 5434 para evitar conflito com instâncias locais do PostgreSQL na 5432.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=documents
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Segurança e Autenticação JWT
JWT_SECRET_KEY=sua_chave_secreta_jwt_gerada_aleatoriamente
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Modelos Locais via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=qwen2.5:7b

# Google AI Studio / Gemini API
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash