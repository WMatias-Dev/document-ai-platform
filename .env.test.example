# Configuração de Banco de Dados para Testes Isolados (PostgreSQL com pgvector)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=documents_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Chave JWT de teste descartável (gerada em runtime caso não definida - NUNCA usar em produção)
JWT_SECRET_KEY=test_jwt_secret_key_insecure_do_not_use_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
